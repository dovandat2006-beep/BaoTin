{
  "openapi": "3.1.0",
  "info": {
    "title": "BaoTin Public Search",
    "version": "1.0.0"
  },
  "security": [],
  "paths": {
    "/api/v1/search": {
      "get": {
        "operationId": "search",
        "security": [],
        "description": "Anonymous owner-approved public Search projection through Gateway. Masked contact/account exact lookups never return raw query values or lookup hashes; private/removed documents are excluded. Existing URL responses remain compatible.",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 2,
              "maxLength": 254
            }
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "URL",
                "PHONE",
                "BANK_ACCOUNT",
                "EMAIL",
                "CAMPAIGN",
                "OTHER"
              ]
            }
          },
          {
            "name": "riskLevel",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "LOW",
                "MEDIUM",
                "HIGH",
                "CRITICAL"
              ]
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000,
              "default": 0
            }
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Ranked projection page",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchPage"
                }
              }
            }
          },
          "400": {
            "description": "Invalid parameters",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Denied operation",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Gateway rate limit",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Projection unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SearchDocument": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "documentType",
          "referenceId",
          "title",
          "displayValue",
          "riskScore",
          "riskLevel",
          "status",
          "metadata",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "referenceId": {
            "type": "string",
            "format": "uuid"
          },
          "documentType": {
            "type": "string",
            "enum": [
              "URL",
              "PHONE",
              "BANK_ACCOUNT",
              "EMAIL",
              "CAMPAIGN",
              "OTHER"
            ]
          },
          "title": {
            "type": "string",
            "maxLength": 253
          },
          "displayValue": {
            "type": "string",
            "maxLength": 253
          },
          "riskScore": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 100
          },
          "riskLevel": {
            "enum": [
              "LOW",
              "MEDIUM",
              "HIGH",
              "CRITICAL",
              null
            ]
          },
          "status": {
            "const": "ACTIVE"
          },
          "metadata": {
            "type": "object",
            "additionalProperties": false,
            "maxProperties": 4,
            "properties": {
              "campaignId": {
                "type": "string",
                "format": "uuid"
              },
              "bankCode": {
                "type": "string",
                "maxLength": 20
              },
              "referenceType": {
                "type": "string",
                "enum": [
                  "URL",
                  "PHONE",
                  "BANK_ACCOUNT",
                  "EMAIL",
                  "CAMPAIGN",
                  "OTHER",
                  "MESSAGE_TEMPLATE"
                ]
              },
              "contentWarning": {
                "enum": [
                  "SUSPICIOUS",
                  "UNKNOWN",
                  "BENIGN"
                ]
              }
            }
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "content": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 10000,
            "description": "Masked full message wording, never a raw private message."
          }
        }
      },
      "SearchPage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items",
          "page",
          "size",
          "totalItems",
          "totalPages"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SearchDocument"
            }
          },
          "page": {
            "type": "integer",
            "minimum": 0
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "totalItems": {
            "type": "integer",
            "minimum": 0
          },
          "totalPages": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "Problem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "correlationId": {
            "type": "string",
            "format": "uuid"
          }
        }
      }
    }
  }
}
