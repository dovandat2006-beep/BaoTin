{
  "openapi": "3.1.0",
  "info": {
    "title": "BaoTin Threat Scan API",
    "version": "1.0.0",
    "description": "Only TEXT/SMS and URL. All public requests through API Gateway. Guests scan without personal history."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "security": [
    {
      "AccessToken": []
    }
  ],
  "paths": {
    "/api/v1/scans/text": {
      "post": {
        "operationId": "scanText",
        "security": [
          {},
          {
            "AccessToken": []
          }
        ],
        "description": "Raw text is sent unchanged to the model; identity/lexical normalization is separate. URL targets are canonicalized and secret/tracking query keys removed. No URL is fetched. Missing AI returns explicit fallback. Compatibility endpoint maps SMS to TEXT.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "content"
                ],
                "properties": {
                  "content": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 10000
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Immutable scan snapshot; guest results are not stored in personal history",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScanResult"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input/filter",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required or invalid bearer",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "413": {
            "description": "Body exceeds 64 KiB",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit or scan capacity",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Storage unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/scans/url": {
      "post": {
        "operationId": "scanUrl",
        "security": [
          {},
          {
            "AccessToken": []
          }
        ],
        "description": "Raw text is sent unchanged to the model; identity/lexical normalization is separate. URL targets are canonicalized and secret/tracking query keys removed. No URL is fetched. Missing AI returns explicit fallback. Compatibility endpoint maps SMS to TEXT.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "url"
                ],
                "properties": {
                  "url": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Immutable scan snapshot; guest results are not stored in personal history",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScanResult"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input/filter",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required or invalid bearer",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "413": {
            "description": "Body exceeds 64 KiB",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit or scan capacity",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Storage unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/scans": {
      "post": {
        "operationId": "scanCompatible",
        "security": [
          {},
          {
            "AccessToken": []
          }
        ],
        "description": "Raw text is sent unchanged to the model; identity/lexical normalization is separate. URL targets are canonicalized and secret/tracking query keys removed. No URL is fetched. Missing AI returns explicit fallback. Compatibility endpoint maps SMS to TEXT.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "content",
                  "type"
                ],
                "properties": {
                  "content": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 10000
                  },
                  "type": {
                    "enum": [
                      "TEXT",
                      "SMS",
                      "URL"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Immutable scan snapshot; guest results are not stored in personal history",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScanResult"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input/filter",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required or invalid bearer",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "413": {
            "description": "Body exceeds 64 KiB",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit or scan capacity",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Storage unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/scans/history": {
      "get": {
        "operationId": "scanHistory",
        "parameters": [
          {
            "in": "query",
            "name": "type",
            "schema": {
              "enum": [
                "TEXT",
                "URL"
              ]
            }
          },
          {
            "in": "query",
            "name": "riskLevel",
            "schema": {
              "enum": [
                "LOW",
                "MEDIUM",
                "HIGH",
                "CRITICAL"
              ]
            }
          },
          {
            "in": "query",
            "name": "page",
            "schema": {
              "type": "integer",
              "default": 0,
              "minimum": 0,
              "maximum": 100000
            }
          },
          {
            "in": "query",
            "name": "size",
            "schema": {
              "type": "integer",
              "default": 20,
              "minimum": 1,
              "maximum": 100
            }
          },
          {
            "in": "query",
            "name": "sort",
            "schema": {
              "enum": [
                "createdAt,desc",
                "createdAt,asc"
              ],
              "default": "createdAt,desc"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Only authenticated subject history, with deterministic ordering",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HistoryPage"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input/filter",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required or invalid bearer",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "deleteAllHistory",
        "responses": {
          "204": {
            "description": "All personal history removed; global reputation targets remain"
          },
          "401": {
            "description": "Authentication required or invalid bearer",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/scans/history/{id}": {
      "parameters": [
        {
          "in": "path",
          "name": "id",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "get": {
        "operationId": "scanHistoryDetail",
        "responses": {
          "200": {
            "description": "Original immutable snapshot",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScanResult"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required or invalid bearer",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Scan absent or owned by another user",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "deleteHistoryItem",
        "responses": {
          "204": {
            "description": "Personal history deleted"
          },
          "401": {
            "description": "Authentication required or invalid bearer",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Scan absent or owned by another user",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "AccessToken": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Prediction": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "modelName",
          "modelVersion",
          "modelChecksum",
          "label",
          "confidence",
          "riskProbability",
          "probabilities",
          "latencyMs"
        ],
        "properties": {
          "modelName": {
            "type": "string"
          },
          "modelVersion": {
            "type": "string"
          },
          "modelChecksum": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "SHA-256 of the verified sha256.json artifact manifest, binding graph, external weights and preprocessing."
          },
          "label": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "riskProbability": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Sum of non-benign class probabilities. Confidence is NOT a risk score."
          },
          "probabilities": {
            "type": "object",
            "additionalProperties": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "latencyMs": {
            "type": "number",
            "minimum": 0
          }
        }
      },
      "Problem": {
        "type": "object",
        "required": [
          "type",
          "title",
          "status",
          "code",
          "correlationId"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "code": {
            "type": "string"
          },
          "correlationId": {
            "type": "string"
          }
        }
      },
      "Risk": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "score",
          "level"
        ],
        "properties": {
          "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "level": {
            "enum": [
              "LOW",
              "MEDIUM",
              "HIGH",
              "CRITICAL"
            ]
          }
        }
      },
      "Rules": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "score",
          "signals"
        ],
        "properties": {
          "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "signals": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "UrlResult": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url",
          "targetId",
          "model",
          "rules",
          "reputationScore",
          "risk",
          "aiAvailable"
        ],
        "properties": {
          "url": {
            "type": "string"
          },
          "targetId": {
            "type": "string",
            "format": "uuid"
          },
          "model": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Prediction"
              },
              {
                "type": "null"
              }
            ]
          },
          "rules": {
            "$ref": "#/components/schemas/Rules"
          },
          "reputationScore": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 100
          },
          "risk": {
            "$ref": "#/components/schemas/Risk"
          },
          "aiAvailable": {
            "type": "boolean"
          }
        }
      },
      "ScanResult": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scanId",
          "type",
          "targetId",
          "preview",
          "risk",
          "textModel",
          "urlModel",
          "rules",
          "urls",
          "aiAvailable",
          "degraded",
          "warnings",
          "scannedAt"
        ],
        "properties": {
          "scanId": {
            "type": "string",
            "format": "uuid"
          },
          "type": {
            "enum": [
              "TEXT",
              "URL"
            ]
          },
          "targetId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "preview": {
            "type": "string",
            "maxLength": 10000,
            "description": "URL summary or complete SMS wording with automatically recognized sensitive values replaced by ***. New messages are not replaced by a blanket hidden-message placeholder."
          },
          "risk": {
            "$ref": "#/components/schemas/Risk"
          },
          "textModel": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Prediction"
              },
              {
                "type": "null"
              }
            ]
          },
          "urlModel": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Prediction"
              },
              {
                "type": "null"
              }
            ]
          },
          "rules": {
            "$ref": "#/components/schemas/Rules"
          },
          "urls": {
            "type": "array",
            "maxItems": 5,
            "items": {
              "$ref": "#/components/schemas/UrlResult"
            }
          },
          "aiAvailable": {
            "type": "boolean"
          },
          "degraded": {
            "type": "boolean"
          },
          "warnings": {
            "type": "array",
            "items": {
              "enum": [
                "TEXT_AI_UNAVAILABLE",
                "URL_AI_UNAVAILABLE",
                "REPUTATION_UNAVAILABLE",
                "EMBEDDED_URL_LIMIT"
              ]
            }
          },
          "scannedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "HistoryPage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items",
          "page",
          "size",
          "totalItems",
          "totalPages"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ScanResult"
            }
          },
          "page": {
            "type": "integer",
            "minimum": 0
          },
          "size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "totalItems": {
            "type": "integer",
            "minimum": 0
          },
          "totalPages": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
