{
  "openapi": "3.1.0",
  "info": {
    "title": "BaoTin Model Inference internal API",
    "version": "1.0.0",
    "description": "Internal only. No Gateway route. Missing or rejected models return 503, never synthetic predictions."
  },
  "servers": [
    {
      "url": "http://model-inference-service:8080"
    }
  ],
  "security": [
    {
      "ServiceToken": []
    }
  ],
  "paths": {
    "/internal/v1/inference/text": {
      "post": {
        "operationId": "inferText",
        "summary": "Text inference (sms is a compatibility alias)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "content"
                ],
                "properties": {
                  "content": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 10000
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Versioned model signal",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Prediction"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid service credential",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "413": {
            "description": "Body exceeds 64 KiB",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Native inference capacity exhausted",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Model missing, invalid or inference failed",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/internal/v1/inference/url": {
      "post": {
        "operationId": "inferUrl",
        "summary": "URL six-class inference",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "url"
                ],
                "properties": {
                  "url": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Versioned model signal",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Prediction"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid service credential",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "413": {
            "description": "Body exceeds 64 KiB",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Native inference capacity exhausted",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Model missing, invalid or inference failed",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/internal/v1/inference/sms": {
      "post": {
        "operationId": "inferSms",
        "summary": "Text inference (sms is a compatibility alias)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "content"
                ],
                "properties": {
                  "content": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 10000
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Versioned model signal",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Prediction"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid service credential",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "413": {
            "description": "Body exceeds 64 KiB",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Native inference capacity exhausted",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Model missing, invalid or inference failed",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/internal/v1/models": {
      "get": {
        "operationId": "listModels",
        "responses": {
          "200": {
            "description": "Both model slots, without filesystem paths",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "text",
                    "url"
                  ],
                  "properties": {
                    "text": {
                      "type": "object",
                      "required": [
                        "status"
                      ],
                      "properties": {
                        "status": {
                          "enum": [
                            "READY",
                            "MISSING",
                            "INVALID_ARTIFACT"
                          ]
                        },
                        "modelName": {
                          "type": "string"
                        },
                        "modelVersion": {
                          "type": "string"
                        },
                        "modelChecksum": {
                          "type": "string"
                        },
                        "labels": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "url": {
                      "type": "object",
                      "required": [
                        "status"
                      ],
                      "properties": {
                        "status": {
                          "enum": [
                            "READY",
                            "MISSING",
                            "INVALID_ARTIFACT"
                          ]
                        },
                        "modelName": {
                          "type": "string"
                        },
                        "modelVersion": {
                          "type": "string"
                        },
                        "modelChecksum": {
                          "type": "string"
                        },
                        "labels": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid service credential",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/actuator/health": {
      "get": {
        "operationId": "healthOverall",
        "security": [],
        "responses": {
          "200": {
            "description": "UP"
          },
          "503": {
            "description": "DOWN; liveness is independent of models, readiness requires both verified models and configured service credential"
          }
        }
      }
    },
    "/actuator/health/liveness": {
      "get": {
        "operationId": "healthLiveness",
        "security": [],
        "responses": {
          "200": {
            "description": "UP"
          },
          "503": {
            "description": "DOWN; liveness is independent of models, readiness requires both verified models and configured service credential"
          }
        }
      }
    },
    "/actuator/health/readiness": {
      "get": {
        "operationId": "healthReadiness",
        "security": [],
        "responses": {
          "200": {
            "description": "UP"
          },
          "503": {
            "description": "DOWN; liveness is independent of models, readiness requires both verified models and configured service credential"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ServiceToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "Separate random service credential (32+ characters), shared only with Threat-Service. Never a user access token."
      }
    },
    "schemas": {
      "Prediction": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "modelName",
          "modelVersion",
          "modelChecksum",
          "label",
          "confidence",
          "riskProbability",
          "probabilities",
          "latencyMs"
        ],
        "properties": {
          "modelName": {
            "type": "string"
          },
          "modelVersion": {
            "type": "string"
          },
          "modelChecksum": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "SHA-256 of the verified sha256.json artifact manifest, binding graph, external weights, tokenizer/preprocessing and Python reference corpus."
          },
          "label": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "riskProbability": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Sum of non-benign class probabilities. Confidence is NOT a risk score."
          },
          "probabilities": {
            "type": "object",
            "additionalProperties": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "latencyMs": {
            "type": "number",
            "minimum": 0
          }
        }
      },
      "Problem": {
        "type": "object",
        "required": [
          "type",
          "title",
          "status",
          "code",
          "correlationId"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "code": {
            "type": "string"
          },
          "correlationId": {
            "type": "string"
          }
        }
      }
    }
  }
}
