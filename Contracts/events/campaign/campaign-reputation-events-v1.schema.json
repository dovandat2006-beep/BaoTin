{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://baotin.example/contracts/campaign/campaign-reputation-events-v1",
  "title": "BaoTin campaign events consumed by Reputation Service v1",
  "description": "Campaign Service owns campaign membership and associations. It publishes a bounded campaign/association signal; Reputation never reads the campaign schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "eventType",
    "eventVersion",
    "occurredAt",
    "producer",
    "aggregateType",
    "aggregateId",
    "correlationId",
    "causationId",
    "payload"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "const": "campaign.updated"
    },
    "eventVersion": {
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "const": "campaign-service"
    },
    "aggregateType": {
      "const": "Campaign"
    },
    "aggregateId": {
      "type": "string",
      "format": "uuid"
    },
    "correlationId": {
      "type": "string",
      "format": "uuid"
    },
    "causationId": {
      "type": ["string", "null"],
      "format": "uuid"
    },
    "traceId": {
      "type": ["string", "null"],
      "maxLength": 128
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["campaignId", "threatTargetId", "targetType", "campaignSignal"],
      "properties": {
        "campaignId": {
          "type": "string",
          "format": "uuid"
        },
        "threatTargetId": {
          "type": "string",
          "format": "uuid"
        },
        "targetType": {
          "type": "string",
          "enum": ["URL", "PHONE", "BANK_ACCOUNT", "EMAIL", "OTHER"]
        },
        "campaignSignal": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      }
    }
  }
}
