{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://baotin.example/contracts/report/report-events-v1",
  "title": "Report lifecycle envelope v1",
  "type": "object",
  "required": [
    "eventId",
    "eventType",
    "eventVersion",
    "occurredAt",
    "producer",
    "aggregateType",
    "aggregateId",
    "correlationId",
    "causationId",
    "payload"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "enum": [
        "report.submitted",
        "report.verified",
        "report.rejected",
        "report.need_more_info"
      ]
    },
    "eventVersion": {
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "const": "report-service"
    },
    "aggregateType": {
      "const": "Report"
    },
    "aggregateId": {
      "type": "string",
      "format": "uuid"
    },
    "correlationId": {
      "type": "string",
      "format": "uuid"
    },
    "causationId": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "payload": {
      "type": "object",
      "required": [
        "reportId",
        "targetId",
        "targetType",
        "reporterUserId",
        "status",
        "version"
      ],
      "properties": {
        "reportId": {
          "type": "string",
          "format": "uuid"
        },
        "targetId": {
          "type": "string",
          "format": "uuid"
        },
        "targetType": {
          "type": "string",
          "enum": [
            "URL",
            "MESSAGE_TEMPLATE"
          ]
        },
        "reporterUserId": {
          "type": "string",
          "format": "uuid"
        },
        "status": {
          "type": "string",
          "enum": [
            "SUBMITTED",
            "PENDING_REVIEW",
            "NEED_MORE_INFO",
            "VERIFIED",
            "REJECTED"
          ]
        },
        "version": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
