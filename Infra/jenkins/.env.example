# =============================================================================
#  BaoTin CI — cấu hình cho hạ tầng phụ trợ trong docker-compose.yml
#
#  cp .env.example .env  rồi điền nếu cần. KHÔNG commit file .env.
#
#  Mọi giá trị ở đây đều TUỲ CHỌN: cấu hình hiện tại (controller tự build)
#  không cần file này. Chỉ cần khi bật build agent:
#      docker compose --profile agent up -d
#
#  Cấu hình Jenkins thật (credentials, job) nằm ở:
#      init/baotin-ci.properties   -> xem init/baotin-ci.properties.example
# =============================================================================

# --- Build agent (profile `agent`) -----------------------------------------
# URL Jenkins mà agent dùng để kết nối vào.
# Đây là URL TRONG mạng docker `jenkins`, không phải URL từ trình duyệt.
JENKINS_URL=http://jenkins-blueocean:8080

JENKINS_AGENT_NAME=jenkins-agent-jdk21

# Secret lấy từ Jenkins khi tạo node:
#   Manage Jenkins → Nodes → New Node → Permanent Agent
#   Launch method: "Launch agent by connecting it to the controller"
#   Copy giá trị trong ô "Secret".
JENKINS_AGENT_SECRET=REPLACE_WITH_JENKINS_AGENT_SECRET
