{
  "uid": "baotin-operations",
  "title": "BaoTin — Operations Overview",
  "tags": [
    "baotin",
    "availability"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values(probe_success{job=~\"service-readiness|website-https|supporting-services\"}, service)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "definition": "label_values(probe_success{job=~\"service-readiness|website-https|supporting-services\"}, service)"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "1. Application and service health",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "title": "Backend and Expo readiness",
      "description": "UP=readiness JSON status UP; DOWN=failed probe. NO DATA is not healthy.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 24,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_success{job=\"service-readiness\",service=~\"$service\"}",
          "legendFormat": "{{service}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ],
          "noValue": "NO DATA"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    },
    {
      "id": 3,
      "title": "Supporting services — HTTP readiness / TCP reachability",
      "description": "SonarQube, Jenkins, MinIO, Grafana HTTP checks; PostgreSQL/Redis/Kafka TCP reachability only. Apply bundled config to populate these series.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 24,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_success{job=\"supporting-services\",service=~\"$service\"}",
          "legendFormat": "{{service}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ],
          "noValue": "NO DATA"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    },
    {
      "id": 4,
      "type": "row",
      "title": "2. Public HTTPS and certificates",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 5,
      "title": "Public HTTPS login pages and BaoTin website",
      "description": "HTTPS200 + HTML + valid TLS. Login-page availability is not an authenticated business transaction.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_success{job=\"website-https\",service=~\"$service\"}",
          "legendFormat": "{{service}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ],
          "noValue": "NO DATA"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    },
    {
      "id": 6,
      "title": "TLS certificate days remaining",
      "description": "Red below14 days, yellow below30 days; check Cloudflare certificate renewal.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 12,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(probe_ssl_earliest_cert_expiry{job=\"website-https\",service=~\"$service\"} - time()) / 86400",
          "legendFormat": "{{service}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "d",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 14
              },
              {
                "color": "green",
                "value": 30
              }
            ]
          },
          "noValue": "NO DATA"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    },
    {
      "id": 7,
      "title": "HTTP response code",
      "description": "Actual probe HTTP status. TCP-only targets do not emit this metric.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 17,
        "w": 12,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_http_status_code{job=~\"service-readiness|website-https|supporting-services\",service=~\"$service\"}",
          "legendFormat": "{{service}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 200
              },
              {
                "color": "yellow",
                "value": 300
              },
              {
                "color": "red",
                "value": 400
              }
            ]
          },
          "mappings": [],
          "noValue": "NO DATA"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    },
    {
      "id": 8,
      "type": "row",
      "title": "3. Availability and synthetic latency",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 9,
      "title": "Probe availability — selected interval",
      "description": "Availability of collected synthetic probes. Samples before monitoring started are not invented; this is not request success rate.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 24,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * avg_over_time(probe_success{job=~\"service-readiness|website-https|supporting-services\",service=~\"$service\"}[$__range])",
          "legendFormat": "{{service}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 99
              },
              {
                "color": "green",
                "value": 99.9
              }
            ]
          },
          "noValue": "NO DATA"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    },
    {
      "id": 10,
      "title": "Probe duration",
      "description": "Synthetic probe duration, not API request latency p95.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_duration_seconds{job=~\"service-readiness|website-https|supporting-services\",service=~\"$service\"}",
          "legendFormat": "{{service}}",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          },
          "noValue": "NO DATA"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 11,
      "title": "Availability timeline",
      "description": "Correlate local service failure with public edge failure.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_success{job=~\"service-readiness|website-https|supporting-services\",service=~\"$service\"}",
          "legendFormat": "{{service}}",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "noValue": "NO DATA"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 12,
      "type": "row",
      "title": "4. Monitoring collectors and alerts",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 35,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 13,
      "title": "Scrape target health",
      "description": "Exporter/scrape health is separate from target readiness. A successful scrape can still contain probe_success=0.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 12,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up",
          "legendFormat": "{{job}} {{service}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "noValue": "NO DATA"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    },
    {
      "id": 14,
      "title": "Firing alerts",
      "description": "No rows is normal when no alerts fire. Rules evaluate in Prometheus; notification delivery is not configured.",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 36,
        "w": 12,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ALERTS{alertstate=\"firing\"}",
          "legendFormat": "{{service}}",
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "noValue": "NO DATA"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 15,
      "title": "Collector resident memory",
      "description": "Memory used by Prometheus/Blackbox only, not application JVM or whole Windows host.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 41,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "process_resident_memory_bytes{job=~\"prometheus|blackbox\"}",
          "legendFormat": "{{job}}",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "noValue": "NO DATA"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 16,
      "title": "Collector CPU cores",
      "description": "Collector CPU core consumption; not whole host utilization.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 41,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(process_cpu_seconds_total{job=~\"prometheus|blackbox\"}[5m])",
          "legendFormat": "{{job}}",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cores",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "noValue": "NO DATA"
        },
        "overrides": []
      },
      "options": {}
    }
  ],
  "id": null,
  "description": "Application readiness, public HTTPS, supporting-service reachability and monitoring collectors. TCP success is reachability only, not dependency correctness.",
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Select the existing BaoTin Prometheus datasource",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "11.0.0"
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    }
  ],
  "links": [
    {
      "title": "BaoTin website",
      "type": "link",
      "url": "https://baotin.rimiprod.me/",
      "targetBlank": true
    },
    {
      "title": "Jenkins",
      "type": "link",
      "url": "https://jenkins.rimiprod.me/",
      "targetBlank": true
    },
    {
      "title": "SonarQube",
      "type": "link",
      "url": "https://sonarqube.rimiprod.me/",
      "targetBlank": true
    }
  ]
}
