# PUBLIC CONFIG/PATHS ONLY. Store actual secrets outside Git in BAOTIN_SECRETS_DIR.
COMPOSE_PROJECT_NAME=baotin-team
BAOTIN_SECRETS_DIR=C:/Users/YOUR_USER/.baotin/secrets
AUTH_IMAGE=ghcr.io/YOUR_ORG/auth-service@sha256:REPLACE_64_HEX
GATEWAY_IMAGE=ghcr.io/YOUR_ORG/api-gateway@sha256:REPLACE_64_HEX
POSTGRES_IMAGE=postgres:17-alpine@sha256:REPLACE_64_HEX
REDIS_IMAGE=redis:7-alpine@sha256:REPLACE_64_HEX
NGINX_IMAGE=nginxinc/nginx-unprivileged:1.28-alpine@sha256:REPLACE_64_HEX
EDGE_PORT=8090
TEAM_SUBNET=172.29.47.0/24
TAILSCALE_API_PORT=9443
# Optional observed Docker Desktop host-proxy IPv6 peer, exact ULA /128 only.
# Populate after ingress observation; never put a tailnet client/network here.
GATEWAY_HOST_PROXY_IPV6_CIDR=
AUTH_ALLOWED_ORIGINS=https://YOUR_TAILSCALE_HOST:9444
# Optional provider/Gmail properties are files in auth-config, not environment secrets.
AUTH_EVENTS_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=
