# Copy outside Git; values here are public paths/configuration, not secret values.
RUNTIME_ROOT=M:/BaoTin-runtime
JAVA_HOME=C:/PATH/TO/JDK21
NODE_EXE=C:/Program Files/nodejs/node.exe
JENKINS_URL=http://[::1]:8080/
JENKINS_USERNAME=YOUR_JENKINS_OPERATOR
JENKINS_API_TOKEN_FILE=C:/Users/USER/.baotin/jenkins-api.token
AUTH_CONFIG_DIR=C:/Users/USER/.baotin/secrets/auth-config
GATEWAY_CONFIG_DIR=C:/Users/USER/.baotin/secrets/gateway-config
THREAT_CONFIG_DIR=C:/Users/USER/.baotin/secrets/threat-config
REPORT_CONFIG_DIR=C:/Users/USER/.baotin/secrets/report-config
NOTIFICATION_CONFIG_DIR=C:/Users/USER/.baotin/secrets/notification-config
REPUTATION_CONFIG_DIR=C:/Users/USER/.baotin/secrets/reputation-config
MODEL_CONFIG_DIR=C:/Users/USER/.baotin/secrets/model-config
MODEL_TEXT_PATH=M:/models/text-1.0.0
MODEL_URL_PATH=M:/models/url-1.0.0
JWT_PRIVATE_KEY_PATH=C:/Users/USER/.baotin/secrets/auth-keys/private.pem
AUTH_ENCRYPTION_KEY_PATH=C:/Users/USER/.baotin/secrets/auth-keys/encryption.bin
DB_URL=jdbc:postgresql://127.0.0.1:15432/baotin
DB_PASSWORD_FILE=C:/Users/USER/.baotin/secrets/auth-config/spring.datasource.password
REDIS_HOST=127.0.0.1
REDIS_PORT=16379
AUTH_ALLOWED_ORIGINS=https://baotin.rimiprod.me
# Add only explicitly reviewed development/Tailscale HTTPS origins; never wildcard.
JWT_KEY_ID=baotin-host-v1
API_PORT=8090
WEB_PORT=8091
# Optional exact HTTPS web origin; omitted uses the current public BảoTin origin.
# WEB_PUBLIC_ORIGIN=https://baotin.example
# Optional Jenkins full-stack deployment targets (paths only; secret files outside Git).
# DOCKER_ALT_ENV_FILE=C:/Users/USER/.baotin/alternative.env
# VPS_CONFIG_FILE=C:/Users/USER/.baotin/vps.env
# VPS_IMAGE_MANIFEST=C:/Users/USER/.baotin/vps-images.json
# VPS_SSH_KEY_FILE=C:/Users/USER/.baotin/vps-deploy-key
# Optional reviewed external manual endpoint file; omit until business services are ready.
# GATEWAY_ROUTES_FILE=C:/Users/USER/.baotin/gateway-routes.properties
# Internet web/API use one origin: https://baotin.rimiprod.me and /api/v1/...
# Backend private loopback ports: Auth8181, other services8182..8189.
# PostgreSQL/Redis run in direct/dependencies Docker Compose; bind host loopback only.
# Optional for pre-Analytics rollback compatibility; required by the new DB-backed Analytics release.
ANALYTICS_CONFIG_DIR=C:/Users/OPERATOR/.baotin/secrets/analytics-config

# Required for Search projection; includes external DB password and Kafka configuration.
SEARCH_CONFIG_DIR=C:/external/baotin/search
