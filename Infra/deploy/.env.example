# =============================================================================
#  BaoTin — Production environment
#  cp .env.example .env  rồi điền giá trị thật.  KHÔNG commit file .env.
# =============================================================================

# --- Owner GitHub (dùng khi deploy bằng tag ngắn) ---
GITHUB_OWNER=baotin
SPRING_PROFILES_ACTIVE=prod

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_DB=baotin
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_strong_password

# Mật khẩu từng service — PHẢI khớp với Infra/init.sql
DB_PASS_AUTH=CHANGE_ME
DB_PASS_THREAT=CHANGE_ME
DB_PASS_REPORT=CHANGE_ME
DB_PASS_REPUTATION=CHANGE_ME
DB_PASS_NOTIFICATION=CHANGE_ME
DB_PASS_SEARCH=CHANGE_ME
DB_PASS_CAMPAIGN=CHANGE_ME
DB_PASS_ANALYTICS=CHANGE_ME

# --- Redis / Kafka / MinIO ---
REDIS_HOST=redis
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
MINIO_ROOT_USER=baotin
MINIO_ROOT_PASSWORD=CHANGE_ME

# --- Ports public ---
HTTP_PORT=80
HTTPS_PORT=443

# --- Port từng service ---
PORT_API_GATEWAY=8080          # Edge gateway: routing, rate limiting, JWT validation
PORT_AUTH_SERVICE=8081          # User, login (password/Google/Facebook), RBAC, JWT/refresh
PORT_THREAT_SERVICE=8082          # SMS/URL inspection orchestrator, scan history, threat target
PORT_REPORT_SERVICE=8083          # Reports, evidence, moderation, appeals
PORT_REPUTATION_SERVICE=8084          # Risk / reputation score aggregation
PORT_MODEL_INFERENCE_SERVICE=8085          # ONNX model inference, emits confidence signal only
PORT_NOTIFICATION_SERVICE=8086          # Push / email notification and preferences
PORT_SEARCH_SERVICE=8087          # Search and read projection (PostgreSQL FTS)
PORT_CAMPAIGN_SERVICE=8088          # Scam campaign detection and grouping
PORT_ANALYTICS_SERVICE=8089          # Business statistics and aggregate metrics

# --- Image tag do deploy.sh ghi đè tự động ---
IMAGE_TAG_API_GATEWAY=ghcr.io/baotin/api-gateway:main
IMAGE_TAG_AUTH_SERVICE=ghcr.io/baotin/auth-service:main
IMAGE_TAG_THREAT_SERVICE=ghcr.io/baotin/threat-service:main
IMAGE_TAG_REPORT_SERVICE=ghcr.io/baotin/report-service:main
IMAGE_TAG_REPUTATION_SERVICE=ghcr.io/baotin/reputation-service:main
IMAGE_TAG_MODEL_INFERENCE_SERVICE=ghcr.io/baotin/model-inference-service:main
IMAGE_TAG_NOTIFICATION_SERVICE=ghcr.io/baotin/notification-service:main
IMAGE_TAG_SEARCH_SERVICE=ghcr.io/baotin/search-service:main
IMAGE_TAG_CAMPAIGN_SERVICE=ghcr.io/baotin/campaign-service:main
IMAGE_TAG_ANALYTICS_SERVICE=ghcr.io/baotin/analytics-service:main