SERVER_PORT=8182
DB_URL=jdbc:postgresql://localhost:5432/baotin
DB_USER=baotin_threat
DB_PASSWORD=
# Use a separate schema-owner migrator, then disable Flyway in the runtime deployment.
DB_MIGRATION_ENABLED=true
DB_MIGRATION_USER=baotin_threat_migrator
DB_MIGRATION_PASSWORD=
# Optional operator-only grant step; runtime role receives business tables, never Flyway history.
DB_RUNTIME_USER=baotin_threat
# Generate outside git with openssl rand -base64 32. Keep stable for private input hashes.
THREAT_HASH_KEY=
THREAT_RETAIN_RAW_TEXT=false
THREAT_CONTENT_KEY=
MODEL_INFERENCE_SERVICE_URI=http://localhost:8185
MODEL_SERVICE_TOKEN=
SCAN_PROVIDER_TIMEOUT_MS=800
AUTH_JWKS_URI=http://localhost:8081/.well-known/jwks.json
JWT_ISSUER=baotin-auth
JWT_AUDIENCE=baotin-api
# Only exact private gateway addresses; trust X-BaoTin-Client-IP solely from those peers.
THREAT_TRUSTED_GATEWAY_CIDRS=
SCAN_GUEST_LIMIT=10
SCAN_USER_LIMIT=60
REPUTATION_SERVICE_URI=
# bearer (legacy Auth-issued ADMIN/MODERATOR JWT) or service-token (private read-only 64 lowercase hex key).
REPUTATION_AUTH_MODE=bearer
# Keep outside Git/client config; service-token must match Reputation's separate REPUTATION_THREAT_READ_TOKEN.
REPUTATION_SERVICE_TOKEN=
THREAT_EVENTS_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

REPORT_THREAT_SERVICE_TOKEN=replace-with-random-at-least-32-characters
NOTIFICATION_THREAT_SERVICE_TOKEN=replace-with-a-separate-random-at-least-32-characters
