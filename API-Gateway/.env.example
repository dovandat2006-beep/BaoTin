SERVER_PORT=8080
AUTH_SERVICE_URI=http://auth-service:8081
AUTH_JWKS_URI=http://auth-service:8081/.well-known/jwks.json
JWT_ISSUER=baotin-auth
JWT_AUDIENCE=baotin-api
GATEWAY_ALLOWED_ORIGINS=https://YOUR_TAILSCALE_HOST:9444
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
# Exact ingress/proxy peer CIDRs only; never the tailnet client range or 0.0.0.0/0.
GATEWAY_TRUSTED_PROXY_CIDRS=
GATEWAY_AUTH_WRITE_LIMIT=30
GATEWAY_AUTH_READ_LIMIT=100
GATEWAY_RATE_WINDOW_SECONDS=300
GATEWAY_PRINCIPAL_LIMIT=100
GATEWAY_PRINCIPAL_WINDOW_SECONDS=600
