gateway.catalog.endpoints[6].path=/api/v1/notifications/preferences
gateway.catalog.endpoints[6].methods[0]=PATCH
gateway.catalog.endpoints[6].anonymous=false

gateway.catalog.endpoints[7].id=list-devices
