gateway.catalog.endpoints[8].path=/api/v1/notifications/devices
gateway.catalog.endpoints[8].methods[0]=POST
gateway.catalog.endpoints[8].anonymous=false

gateway.catalog.endpoints[9].id=delete-device
gateway.catalog.endpoints[9].service=notification
gateway.catalog.endpoints[9].path=/api/v1/notifications/devices/{id}
gateway.catalog.endpoints[9].methods[0]=DELETE
gateway.catalog.endpoints[9].anonymous=false

gateway.catalog.endpoints[10].id=list-watchlist
gateway.catalog.endpoints[10].service=notification
gateway.catalog.endpoints[10].path=/api/v1/watchlist
gateway.catalog.endpoints[10].methods[0]=GET
gateway.catalog.endpoints[10].anonymous=false

gateway.catalog.endpoints[11].id=add-watchlist
gateway.catalog.endpoints[11].service=notification
gateway.catalog.endpoints[11].path=/api/v1/watchlist
gateway.catalog.endpoints[11].methods[0]=POST
gateway.catalog.endpoints[11].anonymous=false

gateway.catalog.endpoints[12].id=delete-watchlist
gateway.catalog.endpoints[12].service=notification
gateway.catalog.endpoints[12].path=/api/v1/watchlist/{id}
gateway.catalog.endpoints[12].methods[0]=DELETE
gateway.catalog.endpoints[12].anonymous=false

