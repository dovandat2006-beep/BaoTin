# Copy outside Git to a reviewed gateway-routes.properties file.
# Services are pre-registered; their stable target can be changed through *_SERVICE_URI.
# The notification/watchlist block below is reviewed against
# Contracts/openapi/notification-service.yaml. JWT is required for every endpoint
# (anonymous=false); the Notification-Service still enforces ownership.

# --- Notification + URL watchlist (Notification-Service) -------------------
gateway.catalog.endpoints[0].id=list-notifications
gateway.catalog.endpoints[0].service=notification
gateway.catalog.endpoints[0].path=/api/v1/notifications
gateway.catalog.endpoints[0].methods[0]=GET
gateway.catalog.endpoints[0].anonymous=false

gateway.catalog.endpoints[1].id=unread-notifications
gateway.catalog.endpoints[1].service=notification
gateway.catalog.endpoints[1].path=/api/v1/notifications/unread-count
gateway.catalog.endpoints[1].methods[0]=GET
gateway.catalog.endpoints[1].anonymous=false

gateway.catalog.endpoints[2].id=read-all-notifications
gateway.catalog.endpoints[2].service=notification
gateway.catalog.endpoints[2].path=/api/v1/notifications/read-all
gateway.catalog.endpoints[2].methods[0]=POST
gateway.catalog.endpoints[2].anonymous=false

gateway.catalog.endpoints[3].id=read-notification
gateway.catalog.endpoints[3].service=notification
gateway.catalog.endpoints[3].path=/api/v1/notifications/{id}/read
gateway.catalog.endpoints[3].methods[0]=PATCH
gateway.catalog.endpoints[3].anonymous=false

gateway.catalog.endpoints[4].id=delete-notification
gateway.catalog.endpoints[4].service=notification
gateway.catalog.endpoints[4].path=/api/v1/notifications/{id}
gateway.catalog.endpoints[4].methods[0]=DELETE
gateway.catalog.endpoints[4].anonymous=false

