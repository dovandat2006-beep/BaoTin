# Placeholder only. Supply secrets through external file/config-tree mounts on deployment.
DB_URL=jdbc:postgresql://postgres:5432/baotin
DB_USER=baotin_auth
DB_PASSWORD=
# Separate migration job only; omit migration credentials from Auth runtime env.
DB_MIGRATION_ENABLED=false
DB_MIGRATION_USER=baotin_auth_migrator
DB_MIGRATION_PASSWORD=
JWT_ISSUER=baotin-auth
JWT_AUDIENCE=baotin-api
JWT_KEY_ID=
JWT_PRIVATE_KEY_PATH=/run/secrets/auth-private-key.pem
AUTH_ENCRYPTION_KEY_PATH=/run/secrets/auth-encryption-key.bin
AUTH_ALLOWED_ORIGINS=https://YOUR_TAILSCALE_HOST:9444
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_HELO_HOST=auth.baotin.internal
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URI=https://YOUR_TAILSCALE_HOST:9443/api/v1/auth/oauth2/callback/google
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_CALLBACK_URI=https://YOUR_TAILSCALE_HOST:9443/api/v1/auth/oauth2/callback/facebook
FACEBOOK_GRAPH_URI=https://graph.facebook.com/v25.0
FACEBOOK_AUTHORIZATION_URI=https://www.facebook.com/v25.0/dialog/oauth
OAUTH_NATIVE_RETURN_URIS=baotin://auth/callback
OAUTH_WEB_RETURN_URIS=https://YOUR_TAILSCALE_HOST:9444/auth/callback
# Isolated operator job/CLI only; never pass these to Auth runtime.
OPERATOR_DB_URL=jdbc:postgresql://postgres:5432/baotin
OPERATOR_DB_USER=baotin_auth_operator
OPERATOR_DB_PASSWORD=
# Spark/free: dev/test only. Leave false on team/prod; never use fictional numbers as real ownership evidence.
FIREBASE_PHONE_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=/run/secrets/firebase-dev-service-account.json
FIREBASE_TEST_PHONES=
JWT_PREVIOUS_PUBLIC_JWKS_PATH=
AUTH_ENCRYPTION_KEY_ID=v1
AUTH_LEGACY_ENCRYPTION_KEY_ID=v1
# Format: old_id=/run/secrets/old-key.bin,older_id=/run/secrets/older-key.bin
AUTH_PREVIOUS_ENCRYPTION_KEYS=
AUTH_EVENTS_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=
KAFKA_SASL_JAAS_CONFIG=
AUTH_TRUSTED_GATEWAY_CIDRS=
AUTH_WRITE_LIMIT=30
AUTH_RATE_WINDOW_SECONDS=300
