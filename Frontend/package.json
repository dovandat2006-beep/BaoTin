{
  "name": "bao-tin-frontend",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "node scripts/start-expo.cjs go",
    "android": "node scripts/start-expo.cjs android",
    "ios": "node scripts/start-expo.cjs ios",
    "web": "node scripts/start-expo.cjs web",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:e2e": "playwright test",
    "build:web": "expo export --platform web",
    "build:android:bundle": "node scripts/build-android-bundle.cjs",
    "verify:android:js": "node scripts/build-android-bundle.cjs --no-bytecode",
    "build:android:release": "node scripts/build-android.cjs both",
    "build:android:aab": "node scripts/build-android.cjs aab",
    "build:android:apk": "node scripts/build-android.cjs apk",
    "build:ios:bundle": "node scripts/build-ios-bundle.cjs",
    "verify": "npm run typecheck && npm test && npm run build:web && npm run test:e2e",
    "test:e2e:scan": "playwright test --config playwright.scan.config.ts",
    "test:e2e:integration": "playwright test -c playwright.integration.config.ts",
    "test:tooling": "node --test --test-concurrency=2 scripts/*.test.cjs scripts/*.test.mjs",
    "verify:ios:js": "node scripts/build-ios-bundle.cjs --no-bytecode"
  },
  "dependencies": {
    "@expo-google-fonts/be-vietnam-pro": "^0.4.1",
    "@expo-google-fonts/lora": "^0.4.2",
    "@expo-google-fonts/manrope": "0.4.2",
    "@expo-google-fonts/roboto": "^0.4.3",
    "@expo-google-fonts/space-grotesk": "0.4.1",
    "@fortawesome/fontawesome-svg-core": "7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "7.3.1",
    "@fortawesome/react-native-fontawesome": "1.0.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.26",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-document-picker": "~58.0.5",
    "expo-file-system": "~58.0.14",
    "expo-font": "~58.0.12",
    "expo-secure-store": "~58.0.3",
    "expo-sharing": "~58.0.23",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.1.0",
    "nativewind": "4.2.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@react-native/jest-preset": "0.88.1",
    "@types/jest": "~30.0.0",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "58.0.21",
    "http-server": "^14.1.1",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.15",
    "prettier-plugin-tailwindcss": "0.5.14",
    "tailwindcss": "3.4.17",
    "typescript": "~6.0.3",
    "zod": "4.6.7"
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/",
      "/.redesign-artifacts/",
      "/tests/e2e/",
      "/playwright-report/",
      "/.verification/"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/.redesign-artifacts/",
      "<rootDir>/.verification/"
    ],
    "testMatch": [
      "<rootDir>/src/**/*.test.ts",
      "<rootDir>/src/**/*.test.tsx"
    ]
  },
  "overrides": {
    "@expo/cli": {
      "zod": "4.6.7"
    }
  }
}
