{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "node",
    "jsx": "react-native",
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["jest", "nativewind/types"]
  },
  "include": ["index.ts", "App.tsx", "src/**/*.ts", "src/**/*.tsx", "nativewind-env.d.ts", "global.d.ts"],
  "exclude": ["node_modules", "dist", "dist-api", "dist-integrated", "dist-android", "dist-ios"]
}
