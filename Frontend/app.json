{
  "expo": {
    "name": "BaoTin",
    "slug": "bao-tin",
    "scheme": "baotin",
    "version": "0.1.6",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "web": {
      "bundler": "metro",
      "name": "BaoTin"
    },
    "android": {
      "package": "vn.baotin.app",
      "icon": "./assets/branding/android-icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/android-adaptive-foreground.png",
        "backgroundColor": "#F6FAF7"
      },
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "versionCode": 7
    },
    "ios": {
      "bundleIdentifier": "vn.baotin.app",
      "supportsTablet": true
    },
    "plugins": [
      "expo-secure-store",
      "expo-sharing"
    ]
  }
}
