# Public HTTPS API Gateway only. This is also the default for Web and Expo Go.
# Never place model credentials, refresh tokens or other secrets in EXPO_PUBLIC_* values.
EXPO_PUBLIC_API_URL=https://baotin.rimiprod.me
EXPO_PUBLIC_DEMO_MODE=0
# Exact return URIs must also be allowlisted in Auth-Service. No provider secret here.
EXPO_PUBLIC_OAUTH_WEB_RETURN_URI=https://baotin.rimiprod.me/auth/callback
EXPO_PUBLIC_OAUTH_NATIVE_RETURN_URI=https://baotin.rimiprod.me/auth/native-callback
